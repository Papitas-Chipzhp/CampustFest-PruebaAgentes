<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      styleClass="pantalla"
      stylesheets="@estilos.css">

    <Label text="Control de ingreso QR" styleClass="titulo"/>
    <Label text="Eventos precargados de ejemplo: ev-1 y ev-2 (ingresa el ID del evento y el código QR confirmado)"
           styleClass="subtitulo-ayuda"
           wrapText="true"
           maxWidth="Infinity"/>

    <Label text="ID del evento" styleClass="etiqueta-campo"/>
    <TextField fx:id="campoEventoId"
               text="ev-1"
               promptText="Ej. ev-1 o ev-2"
               styleClass="campo-texto"/>

    <Label text="Código QR de la reserva" styleClass="etiqueta-campo"/>
    <TextField fx:id="campoCodigoQr"
               promptText="Pega o escribe el código de reserva confirmada"
               styleClass="campo-texto"/>

    <HBox spacing="10">
        <Button text="Registrar ingreso" onAction="#registrarIngreso" styleClass="boton-primario"/>
        <Button text="Limpiar" onAction="#limpiar" styleClass="boton-limpiar"/>
    </HBox>

    <Label fx:id="etiquetaMensaje"
           styleClass="etiqueta-mensaje"
           wrapText="true"
           maxWidth="Infinity"/>
</VBox>
